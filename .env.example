# Placeholders only. Copy to .env and replace every CHANGE_ME. NEVER commit real values.
# Secrets live only on the backend/worker. Only NEXT_PUBLIC_* may reach the browser.

# ---- App ----
APP_ENV=development                 # development | test | staging | production
APP_BASE_URL=http://localhost:3000  # the browser-facing origin (used for CSRF/CORS allow-list)
API_BASE_URL=http://localhost:8000  # where Next.js proxies /api/* (compose overrides to http://api:8000)
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
TRUSTED_PROXY_HOPS=0                # reverse proxies in front of the API that append X-Forwarded-For (0 = ignore it).
                                    # Compose sets 1 (the Next.js proxy). Wrong values either spoof-enable or globalise per-IP limits.

# ---- Database ----
POSTGRES_PASSWORD=CHANGE_ME         # used by docker compose for the postgres service and DATABASE_URL below
DATABASE_URL=postgresql+psycopg://srs:CHANGE_ME@localhost:5432/srs   # must use the same password as above
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_S=10

# ---- Redis / worker ----
REDIS_URL=redis://localhost:6379/0
JOB_DEFAULT_TIMEOUT_S=900
JOB_MAX_RETRIES=3
JOB_STALE_AFTER_S=120               # running job with no heartbeat for this long is presumed lost
JOB_REQUEUE_QUEUED_AFTER_S=60       # queued job whose message may never have been sent is re-dispatched
JOB_SWEEP_INTERVAL_S=60             # how often the recovery sweep runs (lower for crash drills)
WORKER_HEALTH_TIMEOUT_S=1.5

# ---- Auth (self-managed; password recovery is operator-assisted, see README) ----
SESSION_COOKIE_NAME=srs_session
SESSION_TTL_HOURS=168
SESSION_SECRET=CHANGE_ME_LONG_RANDOM   # reserved for signed values in later phases
COOKIE_SECURE=false                    # MUST be true outside development/test (startup fails otherwise)
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=20

# ---- Development seed (APP_ENV=development ONLY; the seed command refuses otherwise) ----
DEV_SEED_EMAIL=demo@example.invalid
DEV_SEED_PASSWORD=CHANGE_ME_demo_password   # development only; seed-dev refuses to run without it

# ---- NOT USED YET (reserved for later phases; documented in docs/architecture/environment-configuration.md) ----
# LLM_PROVIDER, LLM_API_KEY, LLM_MODEL (no default), LLM_SEND_PRIVATE_DOCUMENTS=false (hard default),
# OPENALEX_*, EUROPEPMC_*, SCHOLARLY_CONTACT_EMAIL, STORAGE_*, UPLOAD_*, FEATURE_OCR, FEATURE_WEB_SEARCH
# Email/SMTP settings are intentionally absent: password-reset email is deferred (ADR-0001 amendment A8).

# ---- Frontend (public; never secrets) ----
NEXT_PUBLIC_APP_NAME=Systematic Review Scientist
NEXT_PUBLIC_SESSION_COOKIE_NAME=srs_session
