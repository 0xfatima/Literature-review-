# Placeholders only. Copy to .env and replace every CHANGE_ME. NEVER commit real values.
# Secrets live only on the backend/worker. Only NEXT_PUBLIC_* may reach the browser.

# ---- App ----
APP_ENV=development                 # development | test | staging | production
APP_BASE_URL=http://localhost:3000  # the browser-facing origin (used for CSRF/CORS allow-list)
API_BASE_URL=http://localhost:8000  # where Next.js proxies /api/* (compose overrides to http://api:8000)
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
TRUSTED_PROXY_HOPS=0                # reverse proxies in front of the API that set X-Forwarded-For (0 = ignore it).
                                    # Compose sets 1 (the nginx edge proxy). Next.js rewrites do NOT count: they forward a
                                    # client-supplied header verbatim. Wrong values either spoof-enable or globalise per-IP limits.

# ---- Database ----
POSTGRES_PASSWORD=CHANGE_ME         # used by docker compose for the postgres service and DATABASE_URL below
DATABASE_URL=postgresql+psycopg://srs:CHANGE_ME@localhost:5432/srs   # must use the same password as above
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_S=10

# ---- Redis / worker ----
REDIS_URL=redis://localhost:6379/0
JOB_DEFAULT_TIMEOUT_S=900
JOB_MAX_RETRIES=3
JOB_STALE_AFTER_S=120               # running job with no heartbeat for this long is presumed lost
JOB_REQUEUE_QUEUED_AFTER_S=60       # queued job whose message may never have been sent is re-dispatched
JOB_SWEEP_INTERVAL_S=60             # how often the recovery sweep runs (lower for crash drills)
WORKER_HEALTH_TIMEOUT_S=1.5

# ---- Review workflow (LangGraph; checkpoints in the lg_checkpoints schema of the same database) ----
WORKFLOW_MAX_ITERATIONS=60          # answered questions per checkpoint thread before the run stops with a reason
WORKFLOW_DEBUG_NODE_DELAY_S=0       # TEST HOOK ONLY (worker-crash drill); startup refuses non-zero outside dev/test
# LangGraph depends on langchain-core, which can send traces to LangSmith when these are set. Keep them off:
# nothing about a review is sent anywhere by this application.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# ---- Scholarly search (Phase 4; providers are called only by the worker) ----
SEARCH_PROVIDERS_ENABLED=openalex,europepmc,arxiv,crossref,semanticscholar,pubmed,doaj,openaire,plos,eric,hal,dblp,core
SCHOLARLY_CONTACT_EMAIL=                # your contact e-mail for the OpenAlex/Crossref polite pools (recommended)
# OpenAlex has REQUIRED an API key since 13 Feb 2026: without one you get ~100 credits/day and searches fail with
# HTTP 429 after a handful of requests. The key is free: https://openalex.org/settings/api
OPENALEX_API_KEY=                       # never stored with search records
SEMANTIC_SCHOLAR_API_KEY=               # optional, free on request; without it requests share a throttled public pool
NCBI_API_KEY=                           # optional PubMed key (10 instead of 3 requests/second)
CORE_API_KEY=                           # required for CORE (free: https://core.ac.uk/services/api); CORE is skipped without it
SEARCH_QUERY_BUILDER=auto               # auto = the AI model designs the Boolean query when the protocol has none; rules = never
SEARCH_HTTP_TIMEOUT_S=20
SEARCH_MAX_RETRIES=3                    # per request (timeouts, HTTP 429, 5xx), with exponential backoff
SEARCH_BACKOFF_BASE_S=1.0
SEARCH_MAX_BACKOFF_S=30
SEARCH_PAGE_SIZE=100
SEARCH_MAX_RECORDS_PER_PROVIDER=500     # a query reporting more results is marked "capped", never "complete"
SEARCH_JOB_BUDGET_S=780                 # stop cleanly (resumable) before the worker's hard time limit
RATE_LIMIT_SEARCH_PER_HOUR=30

# ---- LLM (Phase 5). Backend/worker only; NEVER put a real key in this file or in the frontend. ----
# LLM_PROVIDER=none disables every model call (the word-overlap relevance score still works).
LLM_PROVIDER=none                       # none | gemini | groq | openrouter | openai | anthropic (server-wide default)
LLM_API_KEY=                            # put your real key ONLY in your local .env
LLM_MODEL=gemini-flash-latest           # free on Gemini's free tier; users can pick their own model in the app
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_S=60
LLM_MIN_INTERVAL_S=4.5                  # spacing between requests across workers (free tiers allow ~10-30 RPM)
LLM_MAX_RETRIES=3
# Each user can choose a provider/model and save their own API key in the app (Settings, AI model). Keys are
# encrypted with USER_SECRETS_KEY (or a key derived from SESSION_SECRET). Changing it means users re-enter keys.
LLM_ALLOW_USER_KEYS=true
LLM_USER_PROVIDERS=gemini,openrouter,groq,openai,anthropic
USER_SECRETS_KEY=
LLM_SEND_PRIVATE_DOCUMENTS=false        # gate G1; true outside development/test also needs the terms record below
# Gate G2: fill ONLY after a human has reviewed the provider's current data-use terms (empty = not reviewed).
LLM_TERMS_RECORD_VERSION=
LLM_TERMS_REVIEWED_ON=                  # ISO date, e.g. 2026-10-01
LLM_TERMS_REVIEW_INTERVAL_DAYS=365
LLM_BATCH_SIZE=10                       # papers per relevance request
LLM_MAX_PAPERS_PER_JOB=300
RELEVANCE_JOB_BUDGET_S=780
RATE_LIMIT_RELEVANCE_PER_HOUR=20
# Phase 9 evidence extraction (background job; gate G3 = per-project consent given in the app)
EXTRACTION_JOB_BUDGET_S=780
EXTRACTION_CHUNK_CHARS=24000
EXTRACTION_MAX_PAPERS_PER_JOB=50
RATE_LIMIT_EXTRACTION_PER_HOUR=10
# Phase 12 workspace assistant (short AI answers in chat; public metadata and protocol text only)
RATE_LIMIT_ASSISTANT_PER_HOUR=30
# Phase 13 controlled autonomy (pipeline): automatic retries of transient failures and per-run budgets (0 = none)
PIPELINE_MAX_RETRIES=3
PIPELINE_BACKOFF_BASE_S=30
PIPELINE_BACKOFF_CAP_S=900
PIPELINE_TOKEN_BUDGET=2000000
PIPELINE_MAX_JOBS=60
# Limits on AI calls: concurrent calls and tokens per project per day (0 = unlimited)
LLM_MAX_CONCURRENT_CALLS=4
LLM_DAILY_TOKEN_BUDGET=0
SCREENING_TA_REQUIRE_EXCLUSION_REASON=false   # title/abstract: reason encouraged; true = required

# ---- Documents (Phase 6): PDF upload, storage, parsing, OCR ----
# PDFs are untrusted input. They are stored under a generated key and parsed by the worker in a resource-limited child process.
STORAGE_BACKEND=local                   # local | memory (memory is tests-only; S3-compatible storage is not implemented yet)
STORAGE_LOCAL_ROOT=./storage            # relative = from the repository root. The API and the worker MUST see the same directory
UPLOAD_MAX_BYTES=52428800               # 50 MiB per file. infra/proxy/nginx.conf must allow slightly more
UPLOAD_MAX_PAGES=600
UPLOAD_MAX_EXTRACTED_CHARS=15000000
UPLOAD_QUOTA_BYTES_PER_PROJECT=2147483648
UPLOAD_QUOTA_FILES_PER_PROJECT=1000
UPLOAD_QUOTA_BYTES_PER_USER=10737418240
RATE_LIMIT_UPLOAD_PER_HOUR=120
DOCUMENT_REMOVED_RETENTION_DAYS=30      # a removed document's file is kept this long, then purged (0 = at the next sweep)
DOCUMENT_PURGE_INTERVAL_S=3600
DOCUMENT_ORPHAN_GRACE_S=86400           # stored objects with no database row are deleted only after this age
DOCUMENT_PROCESS_TIMEOUT_S=420          # extraction child process; plus OCR_BUDGET_S this must stay below JOB_DEFAULT_TIMEOUT_S
DOCUMENT_CHILD_MEMORY_MB=2048
FEATURE_OCR=false                       # true = OCR pages that have no text layer (needs tesseract; the worker image includes it)
OCR_LANGUAGES=eng                       # tesseract language codes, e.g. eng+deu (the language data must be installed)
OCR_DPI=200
OCR_MAX_PAGES=100
OCR_BUDGET_S=300
OCR_TIMEOUT_PER_PAGE_S=60
TESSERACT_CMD=tesseract
MALWARE_SCANNER=none                    # none | clamav. "none" means uploads are stored as "not scanned" and the UI says so
CLAMD_HOST=localhost
CLAMD_PORT=3310                         # clamd must allow StreamMaxLength of at least UPLOAD_MAX_BYTES
CLAMD_TIMEOUT_S=60
MALWARE_SCAN_REQUIRED=false             # true = a document that cannot be scanned fails instead of being parsed

# ---- Auth (self-managed; password recovery is operator-assisted, see README) ----
SESSION_COOKIE_NAME=srs_session
SESSION_TTL_HOURS=168
SESSION_SECRET=CHANGE_ME_LONG_RANDOM   # reserved for signed values in later phases
COOKIE_SECURE=false                    # MUST be true outside development/test (startup fails otherwise)
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=20
# Security hardening (Phase 14; docs/architecture/security.md)
RATE_LIMIT_WRITES_PER_MIN=600          # state-changing API requests per signed-in session; must be > 0 outside dev/test
MAX_REQUEST_BODY_BYTES=2097152         # non-upload request bodies (uploads are limited by UPLOAD_MAX_BYTES)
HSTS_MAX_AGE_S=31536000                # sent only when COOKIE_SECURE=true
SESSION_RETENTION_DAYS=30              # ended session rows are deleted this long after expiry/revocation
AUDIT_EXPORT_MAX_ROWS=50000

# Performance, concurrency and operations (Phase 15; docs/runbooks/deployment.md, docs/performance.md)
JOB_MAX_INFLIGHT_PER_USER=4            # jobs per user handed to workers at once; the rest wait (fair share)
JOB_MAX_INFLIGHT_GLOBAL=64             # jobs in total handed to workers at once (size to total worker concurrency)
JOB_PUMP_INTERVAL_S=5                  # how often waiting jobs are admitted (also after every finished job)
JOB_FAIR_SHARE_WINDOW_S=600            # least-recently-served user first: admissions in this window count against a user
WORKER_DRAIN_TIMEOUT_S=60              # keep below the orchestrator's stop grace period
LLM_GLOBAL_MAX_CONCURRENT_CALLS=4      # AI calls in flight across ALL processes (protects the provider quota)
LLM_GLOBAL_DAILY_TOKEN_BUDGET=0        # AI tokens per rolling 24 h across all projects; 0 = no limit
SCHOLARLY_ENDPOINTS=                   # optional "provider=https://mirror/..." overrides; https only outside dev
METRICS_TOKEN=                         # bearer token for GET /internal/metrics; empty = endpoint disabled (404)
METRICS_WINDOW_S=900
SECRETS_DIR=                           # production: /run/secrets (one file per secret setting)

# ---- Development seed (APP_ENV=development ONLY; the seed command refuses otherwise) ----
DEV_SEED_EMAIL=demo@example.invalid
DEV_SEED_PASSWORD=CHANGE_ME_demo_password   # development only; seed-dev refuses to run without it

# ---- NOT USED YET (reserved for later phases; documented in docs/architecture/environment-configuration.md) ----
# FEATURE_WEB_SEARCH
# Email/SMTP settings are intentionally absent: password-reset email is deferred (ADR-0001 amendment A8).

# ---- Frontend (public; never secrets) ----
NEXT_PUBLIC_APP_NAME=Systematic Review Scientist
NEXT_PUBLIC_SESSION_COOKIE_NAME=srs_session

# ---- E-mail: password reset and address verification ----
# console = print messages (with their links) to the API log; fine for development. smtp = really send.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com and SMTP_PASSWORD=<16-character app
# password> (Google Account > Security > 2-Step Verification > App passwords; your normal password will not work).
EMAIL_BACKEND=console                   # console | smtp | none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=                              # defaults to SMTP_USERNAME
SMTP_STARTTLS=true
SMTP_USE_SSL=false                      # true for port 465
# Empty = required exactly when EMAIL_BACKEND=smtp. New accounts must click the e-mailed link before signing in.
AUTH_REQUIRE_EMAIL_VERIFICATION=
EMAIL_CHECK_DNS=true                    # refuse addresses whose domain has no mail server
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=48
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
