# Placeholders only. Copy to .env and replace every CHANGE_ME. NEVER commit real values.
# Secrets live only on the backend/worker. Only NEXT_PUBLIC_* may reach the browser.

# ---- App ----
APP_ENV=development                 # development | test | staging | production
APP_BASE_URL=http://localhost:3000  # the browser-facing origin (used for CSRF/CORS allow-list)
API_BASE_URL=http://localhost:8000  # where Next.js proxies /api/* (compose overrides to http://api:8000)
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
TRUSTED_PROXY_HOPS=0                # reverse proxies in front of the API that set X-Forwarded-For (0 = ignore it).
                                    # Compose sets 1 (the nginx edge proxy). Next.js rewrites do NOT count: they forward a
                                    # client-supplied header verbatim. Wrong values either spoof-enable or globalise per-IP limits.

# ---- Database ----
POSTGRES_PASSWORD=CHANGE_ME         # used by docker compose for the postgres service and DATABASE_URL below
DATABASE_URL=postgresql+psycopg://srs:CHANGE_ME@localhost:5432/srs   # must use the same password as above
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_S=10

# ---- Redis / worker ----
REDIS_URL=redis://localhost:6379/0
JOB_DEFAULT_TIMEOUT_S=900
JOB_MAX_RETRIES=3
JOB_STALE_AFTER_S=120               # running job with no heartbeat for this long is presumed lost
JOB_REQUEUE_QUEUED_AFTER_S=60       # queued job whose message may never have been sent is re-dispatched
JOB_SWEEP_INTERVAL_S=60             # how often the recovery sweep runs (lower for crash drills)
WORKER_HEALTH_TIMEOUT_S=1.5

# ---- Review workflow (LangGraph; checkpoints in the lg_checkpoints schema of the same database) ----
WORKFLOW_MAX_ITERATIONS=60          # answered questions per checkpoint thread before the run stops with a reason
WORKFLOW_DEBUG_NODE_DELAY_S=0       # TEST HOOK ONLY (worker-crash drill); startup refuses non-zero outside dev/test
# LangGraph depends on langchain-core, which can send traces to LangSmith when these are set. Keep them off:
# nothing about a review is sent anywhere by this application.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# ---- Scholarly search (Phase 4; providers are called only by the worker) ----
SEARCH_PROVIDERS_ENABLED=openalex,europepmc,arxiv,crossref
SCHOLARLY_CONTACT_EMAIL=                # your contact e-mail for the OpenAlex/Crossref polite pools (recommended)
OPENALEX_API_KEY=                       # optional; leave empty unless you have one. Never stored with search records
SEARCH_HTTP_TIMEOUT_S=20
SEARCH_MAX_RETRIES=3                    # per request (timeouts, HTTP 429, 5xx), with exponential backoff
SEARCH_BACKOFF_BASE_S=1.0
SEARCH_MAX_BACKOFF_S=30
SEARCH_PAGE_SIZE=100
SEARCH_MAX_RECORDS_PER_PROVIDER=500     # a query reporting more results is marked "capped", never "complete"
SEARCH_JOB_BUDGET_S=780                 # stop cleanly (resumable) before the worker's hard time limit
RATE_LIMIT_SEARCH_PER_HOUR=30

# ---- LLM (Phase 5). Backend/worker only; NEVER put a real key in this file or in the frontend. ----
# LLM_PROVIDER=none disables every model call (the word-overlap relevance score still works).
LLM_PROVIDER=none                       # none | gemini
LLM_API_KEY=                            # put your real key ONLY in your local .env
LLM_MODEL=gemini-2.5-flash-lite         # free-tier model at the time of writing; verify in Google AI Studio
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_S=60
LLM_MIN_INTERVAL_S=4.5                  # spacing between requests across workers (free tiers allow ~10-30 RPM)
LLM_MAX_RETRIES=3
LLM_SEND_PRIVATE_DOCUMENTS=false        # must stay false; startup refuses true outside development/test
LLM_BATCH_SIZE=10                       # papers per relevance request
LLM_MAX_PAPERS_PER_JOB=300
RELEVANCE_JOB_BUDGET_S=780
RATE_LIMIT_RELEVANCE_PER_HOUR=20
SCREENING_TA_REQUIRE_EXCLUSION_REASON=false   # title/abstract: reason encouraged; true = required

# ---- Auth (self-managed; password recovery is operator-assisted, see README) ----
SESSION_COOKIE_NAME=srs_session
SESSION_TTL_HOURS=168
SESSION_SECRET=CHANGE_ME_LONG_RANDOM   # reserved for signed values in later phases
COOKIE_SECURE=false                    # MUST be true outside development/test (startup fails otherwise)
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=20

# ---- Development seed (APP_ENV=development ONLY; the seed command refuses otherwise) ----
DEV_SEED_EMAIL=demo@example.invalid
DEV_SEED_PASSWORD=CHANGE_ME_demo_password   # development only; seed-dev refuses to run without it

# ---- NOT USED YET (reserved for later phases; documented in docs/architecture/environment-configuration.md) ----
# STORAGE_*, UPLOAD_*, FEATURE_OCR, FEATURE_WEB_SEARCH
# Email/SMTP settings are intentionally absent: password-reset email is deferred (ADR-0001 amendment A8).

# ---- Frontend (public; never secrets) ----
NEXT_PUBLIC_APP_NAME=Systematic Review Scientist
NEXT_PUBLIC_SESSION_COOKIE_NAME=srs_session
