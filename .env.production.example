# Production configuration (Phase 15). NON-SECRET values only: secrets live in ./secrets/ (scripts/gen-secrets.sh)
# and are mounted as Docker secrets. Copy to .env.production (git-ignored) and edit. See docs/runbooks/deployment.md.
APP_BASE_URL=https://reviews.example.org
API_BASE_URL=https://reviews.example.org
CORS_ALLOWED_ORIGINS=https://reviews.example.org
LOG_LEVEL=INFO
SRS_VERSION=local                       # image tag; set to the git commit or release you deploy

# Capacity (size to the hardware; docs/performance.md has measured numbers)
WORKER_INTERACTIVE_CONCURRENCY=4
WORKER_HEAVY_CONCURRENCY=2
JOB_MAX_INFLIGHT_PER_USER=4
JOB_MAX_INFLIGHT_GLOBAL=12              # ~ total worker concurrency x 2
DB_POOL_SIZE=10

# Providers. LLM_API_KEY is a secret (./secrets/llm_api_key; leave the file empty to keep AI disabled).
SEARCH_PROVIDERS_ENABLED=openalex,europepmc,arxiv,crossref,semanticscholar,pubmed,doaj,openaire,plos,eric,hal,dblp,core
SCHOLARLY_CONTACT_EMAIL=operator@example.org
LLM_PROVIDER=none
LLM_MODEL=
LLM_SEND_PRIVATE_DOCUMENTS=false
LLM_TERMS_RECORD_VERSION=
LLM_TERMS_REVIEWED_ON=
LLM_MAX_CONCURRENT_CALLS=2
LLM_GLOBAL_MAX_CONCURRENT_CALLS=4       # whole deployment; keep within the provider's concurrency/RPM allowance
LLM_GLOBAL_DAILY_TOKEN_BUDGET=2000000
LLM_DAILY_TOKEN_BUDGET=500000

# Security
SESSION_TTL_HOURS=168
RATE_LIMIT_WRITES_PER_MIN=600
MALWARE_SCANNER=none

# ---- E-mail (password reset + verification). Use smtp in production; console does not print links here. ----
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_FROM=
# SMTP_PASSWORD and USER_SECRETS_KEY are secrets: put them in SECRETS_DIR files (smtp_password, user_secrets_key).
